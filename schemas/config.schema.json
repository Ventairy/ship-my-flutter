{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Ventairy/ship-my-flutter/main/schemas/config.schema.json",
  "title": "ship-my-flutter configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_branch",
    "release_branch_prefix",
    "hooks",
    "platforms"
  ],
  "properties": {
    "schema_version": {
      "const": 2,
      "description": "Configuration contract version."
    },
    "target_branch": {
      "type": "string",
      "minLength": 1,
      "default": "main",
      "description": "Branch whose commits feed release pull requests."
    },
    "release_branch_prefix": {
      "type": "string",
      "minLength": 1,
      "default": "ship-my-flutter",
      "description": "Prefix for generated platform release branches."
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "before_release_pr": {
          "type": "string",
          "minLength": 1,
          "description": "POSIX shell command run after the next version and changelog are prepared."
        },
        "before_candidate": {
          "type": "string",
          "minLength": 1,
          "description": "POSIX shell command run before candidate source is fingerprinted and built."
        }
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ios"],
      "properties": {
        "ios": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "project_path",
            "build_command",
            "artifact_path",
            "testflight",
            "app_store"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Enable iOS release planning and delivery."
            },
            "project_path": {
              "type": "string",
              "minLength": 1,
              "default": ".",
              "description": "Flutter project root relative to the repository."
            },
            "bundle_id": {
              "type": "string",
              "minLength": 1,
              "description": "App Store bundle identifier. Explicit configuration is recommended."
            },
            "scheme": {
              "type": "string",
              "minLength": 1,
              "description": "Xcode scheme used for bundle identifier detection and exposed to the build command."
            },
            "build_command": {
              "type": "string",
              "minLength": 1,
              "default": "flutter build ipa --release",
              "description": "POSIX shell build invocation. ship-my-flutter appends version, build number, export-options, and configured flavor arguments.",
              "not": {
                "pattern": "(^|\\s)--(build-name|build-number|export-options-plist|flavor)(\\s|=|$)"
              }
            },
            "artifact_path": {
              "type": "string",
              "minLength": 1,
              "default": "build/ios/ipa",
              "description": "IPA file or directory relative to project_path."
            },
            "testflight": {
              "type": "object",
              "additionalProperties": false,
              "required": ["groups", "wait_timeout_minutes"],
              "properties": {
                "groups": {
                  "type": "array",
                  "description": "Exact existing TestFlight group names that should receive the build.",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "wait_timeout_minutes": {
                  "type": "integer",
                  "minimum": 5,
                  "maximum": 180,
                  "default": 45,
                  "description": "Maximum time to wait for Apple build processing."
                }
              }
            },
            "app_store": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "release_type"],
              "properties": {
                "mode": {
                  "enum": ["submit-for-review", "upload-only"],
                  "default": "upload-only",
                  "description": "Whether merging uploads only or also submits the tested build for App Review."
                },
                "release_type": {
                  "enum": ["manual", "automatic", "scheduled"],
                  "default": "manual",
                  "description": "Release behavior after Apple approves the submission."
                },
                "earliest_release_date": {
                  "type": "string",
                  "format": "date-time",
                  "description": "ISO 8601 release time required for a scheduled release."
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "release_type": {
                        "const": "scheduled"
                      }
                    },
                    "required": ["release_type"]
                  },
                  "then": {
                    "required": ["earliest_release_date"]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "release_type": {
                        "not": {
                          "const": "scheduled"
                        }
                      }
                    },
                    "required": ["release_type"]
                  },
                  "then": {
                    "not": {
                      "required": ["earliest_release_date"]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
