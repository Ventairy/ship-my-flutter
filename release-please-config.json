{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "8fefd5a092583a71f76a5a510a3aac878ca63daa",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "release-type": "dart",
  "separate-pull-requests": false,
  "group-pull-request-title-pattern": "chore: release ${branch}",
  "packages": {
    "packages/smf_hooks": {
      "component": "smf_hooks",
      "include-paths": [
        "packages/smf_hooks"
      ]
    },
    "packages/smf_engine": {
      "component": "smf_engine",
      "extra-files": [
        {
          "type": "generic",
          "path": "lib/src/templates.dart"
        }
      ],
      "include-paths": [
        "packages/smf_engine"
      ]
    },
    "packages/smf_cli": {
      "component": "smf_cli",
      "extra-files": [
        {
          "type": "generic",
          "path": "lib/src/upgrade.dart"
        }
      ],
      "include-paths": [
        "packages/smf_cli"
      ]
    }
  }
}
