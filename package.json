{
  "name": "ship-my-flutter",
  "version": "0.1.0",
  "description": "Release PRs, TestFlight candidates, and App Store submission for Flutter apps.",
  "type": "module",
  "bin": {
    "ship-my-flutter": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "schemas",
    "templates",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "flutter",
    "ios",
    "testflight",
    "app-store",
    "release",
    "github-actions"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ventairy/ship-my-flutter.git"
  },
  "bugs": {
    "url": "https://github.com/Ventairy/ship-my-flutter/issues"
  },
  "homepage": "https://github.com/Ventairy/ship-my-flutter#readme",
  "dependencies": {
    "@octokit/rest": "22.0.1",
    "commander": "15.0.0",
    "conventional-commits-parser": "7.1.1",
    "jose": "6.2.4",
    "plist": "5.0.0",
    "semver": "7.8.5",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/plist": "^3.0.5",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
