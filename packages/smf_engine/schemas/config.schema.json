{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Ventairy/smf/main/packages/smf_engine/schemas/config.schema.json",
  "title": "smf configuration",
  "$comment": "This schema provides structure, defaults, and conservative editor checks. The smf validate command is authoritative for shell syntax, cross-field rules, and platform-independent path safety.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "app_id", "platforms"],
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "Configuration contract version."
    },
    "app_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "Stable repository-unique identity used to namespace this app's workflow, release branch, tags, GitHub Releases, and environment."
    },
    "flavor": {
      "type": "string",
      "minLength": 1,
      "description": "Optional Flutter flavor selected for every platform build."
    },
    "target_branch": {
      "type": "string",
      "minLength": 1,
      "default": "main",
      "description": "Branch whose commits feed release pull requests."
    },
    "release_trigger_paths": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "description": "Additional repository-relative paths or glob patterns whose qualifying commits apply to this app. The Flutter app directory is always included.",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![\\\\/])(?![A-Za-z]:[\\\\/])(?!\\.\\.(?:[\\\\/]|$))(?!.*[\\\\/]\\.\\.(?:[\\\\/]|$)).+$"
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "ios": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Enable iOS release planning and delivery."
            },
            "initial_version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
              "default": "0.0.0",
              "description": "Current iOS marketing version used only until the first generated release manifest exists."
            },
            "bundle_id": {
              "type": "string",
              "minLength": 1,
              "description": "App Store bundle identifier. Explicit configuration is recommended."
            },
            "build_command": {
              "type": "string",
              "minLength": 1,
              "description": "Optional POSIX shell build command. When omitted, smf uses fvm flutter build ipa --release if the project or repository has FVM configuration, and flutter build ipa --release otherwise. Chaining, pipelines, redirections, comments, and command substitution are rejected because smf appends version, build number, export-options, and configured flavor arguments to this invocation.",
              "not": {
                "pattern": "--(build-name|build-number|export-options-plist|flavor)"
              }
            },
            "ipa_output_path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![\\\\/])(?![A-Za-z]:[\\\\/])(?!\\.\\.(?:[\\\\/]|$))(?!.*[\\\\/]\\.\\.(?:[\\\\/]|$)).+$",
              "default": "build/ios/ipa",
              "description": "IPA file or directory relative to the Flutter app. Override only when a custom build command writes outside Flutter's standard build/ios/ipa directory."
            },
            "app_store": {
              "type": "object",
              "default": {},
              "additionalProperties": false,
              "properties": {
                "release_candidate": {
                  "type": "object",
                  "default": {},
                  "additionalProperties": false,
                  "properties": {
                    "target": {
                      "enum": ["internal-testing", "external-testing"],
                      "default": "internal-testing",
                      "description": "TestFlight audience that receives the candidate while the release PR is open."
                    },
                    "groups": {
                      "type": "array",
                      "default": [],
                      "uniqueItems": true,
                      "description": "Exact existing TestFlight group names matching the selected target.",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "wait_timeout_minutes": {
                      "type": "integer",
                      "minimum": 5,
                      "maximum": 180,
                      "default": 45,
                      "description": "Maximum time to wait for Apple build processing."
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "target": {
                            "const": "external-testing"
                          }
                        },
                        "required": ["target"]
                      },
                      "then": {
                        "required": ["groups"],
                        "properties": {
                          "groups": {
                            "minItems": 1
                          }
                        }
                      }
                    }
                  ]
                },
                "ship": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["target"],
                  "properties": {
                    "target": {
                      "enum": [
                        "external-testing",
                        "submit-for-review",
                        "production"
                      ],
                      "description": "Apple destination or review action performed after the release PR is merged."
                    },
                    "groups": {
                      "type": "array",
                      "default": [],
                      "uniqueItems": true,
                      "description": "Exact external TestFlight groups used by external-testing.",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "target": {
                            "const": "external-testing"
                          }
                        }
                      },
                      "then": {
                        "required": ["groups"],
                        "properties": {
                          "groups": {
                            "minItems": 1
                          }
                        }
                      },
                      "else": {
                        "properties": {
                          "groups": {
                            "maxItems": 0
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "android": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Enable Android release planning and Google Play delivery."
            },
            "initial_version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
              "default": "0.0.0",
              "description": "Current Android marketing version used only until the first generated release manifest exists."
            },
            "package_name": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$",
              "description": "Google Play package name. Required for flavors and recommended for every app."
            },
            "build_command": {
              "type": "string",
              "minLength": 1,
              "description": "Optional POSIX shell build command. SMF appends the marketing version, version code, and configured flavor.",
              "not": {
                "pattern": "--(build-name|build-number|flavor)"
              }
            },
            "aab_output_path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![\\\\/])(?![A-Za-z]:[\\\\/])(?!\\.\\.(?:[\\\\/]|$))(?!.*[\\\\/]\\.\\.(?:[\\\\/]|$)).+$",
              "default": "build/app/outputs/bundle/release",
              "description": "AAB file or directory relative to the Flutter app."
            },
            "google_play": {
              "type": "object",
              "default": {},
              "additionalProperties": false,
              "properties": {
                "release_candidate": {
                  "type": "object",
                  "default": {},
                  "additionalProperties": false,
                  "properties": {
                    "target": {
                      "enum": [
                        "internal-testing",
                        "closed-testing",
                        "open-testing"
                      ],
                      "default": "internal-testing",
                      "description": "Google Play destination that receives the candidate while the release PR is open."
                    },
                    "tracks": {
                      "type": "array",
                      "default": [],
                      "uniqueItems": true,
                      "description": "Existing custom closed-testing track names.",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9._-]+$"
                      }
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "target": {
                            "const": "closed-testing"
                          }
                        }
                      },
                      "then": {
                        "required": ["tracks"],
                        "properties": {
                          "tracks": {
                            "minItems": 1
                          }
                        }
                      },
                      "else": {
                        "properties": {
                          "tracks": {
                            "maxItems": 0
                          }
                        }
                      }
                    }
                  ]
                },
                "ship": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["target"],
                  "properties": {
                    "target": {
                      "enum": [
                        "closed-testing",
                        "open-testing",
                        "production"
                      ],
                      "description": "Google Play destination used after the release PR is merged."
                    },
                    "tracks": {
                      "type": "array",
                      "default": [],
                      "uniqueItems": true,
                      "description": "Existing custom closed-testing track names.",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9._-]+$"
                      }
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "target": {
                            "const": "closed-testing"
                          }
                        }
                      },
                      "then": {
                        "required": ["tracks"],
                        "properties": {
                          "tracks": {
                            "minItems": 1
                          }
                        }
                      },
                      "else": {
                        "properties": {
                          "tracks": {
                            "maxItems": 0
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
